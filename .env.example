# Server-side only. The Azure Functions API reads these values; never rename them to VITE_* variables.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Set this only if your backend integration requires an explicit API version.
AZURE_OPENAI_API_VERSION=2024-10-21
