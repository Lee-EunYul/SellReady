# Server-side only. Never rename these to VITE_* variables.
# This Vite-only app has no backend yet, so these values are not consumed by the browser app.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Comma-separated Microsoft Entra sign-in email allowlist; empty means AI calls are denied.
AZURE_OPENAI_ALLOWED_EMAILS=your-microsoft-login@example.com
# Set this only if your backend integration requires an explicit API version.
AZURE_OPENAI_API_VERSION=
